rules_version = '2';

// Everything not matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isBloodType(value) {
      return value in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function isBloodTypeOrNull(value) {
      return value == null || isBloodType(value);
    }

    function isStringOrNull(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    function isISODateOrNull(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isUrgency(value) {
      return value in ['critical', 'urgent', 'standard'];
    }

    // Profile photos are small data URLs (~30 KB); cap them well under Firestore's 1 MB doc limit.
    function isPhotoOrNull(value) {
      return value == null || (value is string && value.size() <= 300000 && value.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    function hasMedicalRecordDoc(uid) {
      return exists(/databases/$(database)/documents/medicalRecords/$(uid));
    }

    function donorCard(uid) {
      return get(/databases/$(database)/documents/donors/$(uid)).data;
    }

    // ---------- Private profile: email, phone, birthday, settings. Only the owner can see it. ----------
    match /users/{uid} {
      function profileKeys() {
        return ['uid', 'fullName', 'email', 'phone', 'dateOfBirth', 'gender', 'photoURL', 'bloodGroup', 'rhFactor',
          'bloodType', 'location', 'available', 'lastDonation', 'totalDonations', 'about', 'medicalRecord', 'onboarded',
          'privacy', 'notifications', 'createdAt'];
      }

      function validProfile() {
        let data = request.resource.data;
        return data.fullName is string && data.fullName.size() <= 80
          && isStringOrNull(data.get('email', null), 254)
          && isStringOrNull(data.get('phone', null), 20)
          && isStringOrNull(data.get('about', null), 300)
          && isStringOrNull(data.get('gender', null), 30)
          && isStringOrNull(data.get('dateOfBirth', null), 10)
          && data.get('bloodGroup', null) in [null, 'A', 'B', 'AB', 'O']
          && data.get('rhFactor', null) in [null, '+', '-']
          && isBloodTypeOrNull(data.get('bloodType', null))
          && isStringOrNull(data.get('location', null), 80)
          && isPhotoOrNull(data.get('photoURL', null))
          && isISODateOrNull(data.get('lastDonation', null))
          && data.get('available', false) is bool
          && data.get('totalDonations', 0) is int && data.get('totalDonations', 0) >= 0
          && (data.get('medicalRecord', null) == null
            || (isText(data.medicalRecord.kind, 40) && isText(data.medicalRecord.issuer, 100)
              && isText(data.medicalRecord.issuedOn, 10) && isText(data.medicalRecord.uploadedAt, 10)));
      }

      allow read, delete: if isUser(uid);
      allow create: if isUser(uid) && request.resource.data.keys().hasOnly(profileKeys()) && validProfile();
      // Updates may only touch known fields (older docs may still carry retired ones, which are left alone).
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
        && validProfile();
    }

    // ---------- Donor's medical record photo. Private to the owner. ----------
    match /medicalRecords/{uid} {
      function validRecord() {
        let data = request.resource.data;
        return data.keys().hasOnly(['kind', 'issuer', 'issuedOn', 'uploadedAt', 'image', 'updatedAt'])
          && isText(data.kind, 40)
          && isText(data.issuer, 100)
          && isText(data.issuedOn, 10) && isText(data.uploadedAt, 10)
          && data.image is string && data.image.size() <= 900000
          && data.image.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$');
      }

      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && validRecord();
    }

    // ---------- Public donor card. Any signed-in user can read it. ----------
    match /donors/{uid} {
      function validCard() {
        let data = request.resource.data;
        return isText(data.get('name', ''), 40)
          && isBloodTypeOrNull(data.get('bloodType', null))
          && isStringOrNull(data.get('location', null), 80)
          && isStringOrNull(data.get('about', null), 300)
          && isPhotoOrNull(data.get('photoURL', null))
          && isISODateOrNull(data.get('lastDonation', null))
          && isISODateOrNull(data.get('eligibleFrom', null))
          && data.get('available', false) is bool
          && data.get('searchable', false) is bool
          && data.get('verified', false) is bool
          // "Verified" and appearing in searches both require a medical record that actually exists.
          && (data.get('verified', false) == false || hasMedicalRecordDoc(uid))
          && (data.get('searchable', false) == false
            || (hasMedicalRecordDoc(uid) && data.get('bloodType', null) != null && data.get('location', null) != null));
      }

      function cardKeys() {
        return ['uid', 'name', 'bloodType', 'location', 'available', 'searchable', 'lastDonation',
          'verified', 'eligibleFrom', 'about', 'photoURL', 'lastActiveAt'];
      }

      allow read: if signedIn();
      allow create: if isUser(uid) && request.resource.data.keys().hasOnly(cardKeys()) && validCard();
      // Older cards may still carry retired fields; updates may only touch known ones.
      allow update: if isUser(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(cardKeys()) && validCard();
      allow delete: if isUser(uid);
    }

    // ---------- Blood requests: private to the requester and the donor asked. ----------
    match /requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.requesterId == request.auth.uid || resource.data.donorId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['requesterId', 'requesterName', 'donorId', 'donorName', 'bloodType',
          'quantity', 'location', 'reason', 'urgency', 'hospital', 'neededBy', 'needId', 'status', 'expiresAt', 'createdAt'])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.donorId != request.auth.uid
        && request.resource.data.status == 'pending'
        // Names must match the public cards, so nobody can pose as someone else.
        && request.resource.data.requesterName == donorCard(request.auth.uid).name
        && request.resource.data.donorName == donorCard(request.resource.data.donorId).name
        // Only donors who are actually listed (available, verified) can be asked.
        && donorCard(request.resource.data.donorId).searchable == true
        && isBloodType(request.resource.data.bloodType)
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 10
        && isText(request.resource.data.location, 80)
        && isText(request.resource.data.reason, 200)
        && isUrgency(request.resource.data.urgency)
        && isText(request.resource.data.hospital, 100)
        && isISODateOrNull(request.resource.data.get('neededBy', null))
        && isStringOrNull(request.resource.data.get('needId', null), 40)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // Donor: pending → accepted/declined (accept only before the request expires), accepted → completed.
        (resource.data.donorId == request.auth.uid
          && ((resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined']
                && (request.resource.data.status == 'declined'
                  || resource.data.get('expiresAt', null) == null
                  || request.time < resource.data.expiresAt)
                && changesOnly(['status', 'respondedAt']))
            || (resource.data.status == 'accepted'
                && request.resource.data.status == 'completed'
                && changesOnly(['status', 'completedAt']))))
        // Requester: pending → cancelled.
        || (resource.data.requesterId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && changesOnly(['status', 'respondedAt']))
      );
    }

    // ---------- Anonymous city-level summary of open requests (no names, no reasons). ----------
    match /needs/{needId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['requesterId', 'bloodType', 'location', 'urgency', 'quantity',
          'pledged', 'donated', 'donorIds', 'open', 'expiresAt', 'createdAt'])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.open == true
        && isBloodType(request.resource.data.bloodType)
        && isText(request.resource.data.location, 80)
        && isUrgency(request.resource.data.urgency)
        && request.resource.data.donorIds is list && request.resource.data.donorIds.size() <= 20
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 10
        && request.resource.data.pledged == 0 && request.resource.data.donated == 0
        && request.resource.data.expiresAt is timestamp;

      // Counters only move up by one (one donor = one unit).
      function stepsByAtMostOne(field) {
        return request.resource.data.get(field, 0) is int
          && request.resource.data.get(field, 0) >= resource.data.get(field, 0)
          && request.resource.data.get(field, 0) <= resource.data.get(field, 0) + 1;
      }

      allow update: if signedIn() && (
        // Requester can close it (e.g. after cancelling).
        (resource.data.requesterId == request.auth.uid
          && request.resource.data.open == false
          && changesOnly(['open', 'closedAt']))
        // A donor who was asked can pledge a unit, record their donation, and close it when it's fulfilled.
        || (request.auth.uid in resource.data.donorIds
          && changesOnly(['pledged', 'donated', 'open', 'closedAt'])
          && stepsByAtMostOne('pledged') && stepsByAtMostOne('donated')
          && request.resource.data.open in [resource.data.open, false])
      );
    }

    // ---------- In-app notifications. ----------
    match /notifications/{notificationId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && changesOnly(['read']);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'actorId', 'type', 'title', 'link', 'read', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.read == false
        && request.resource.data.type in ['request', 'accepted', 'declined', 'completed', 'status', 'message', 'reminder']
        && isText(request.resource.data.title, 200)
        // Links stay inside the app: a path like /requests/abc, never an external URL.
        && (request.resource.data.link == null
          || (request.resource.data.link is string && request.resource.data.link.size() <= 200
            && request.resource.data.link.matches('^/[A-Za-z0-9/_?=&.-]*$')
            && !request.resource.data.link.matches('^//.*')));
    }

    // ---------- Chats between two people. ----------
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if isParticipant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'names', 'updatedAt', 'lastMessage', 'lastSenderId', 'unread'])
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && changesOnly(['names', 'updatedAt', 'lastMessage', 'lastSenderId', 'unread'])
        && isStringOrNull(request.resource.data.get('lastMessage', null), 1000)
        // You can only post the latest message as yourself.
        && (!('lastSenderId' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.lastSenderId == request.auth.uid);

      match /messages/{messageId} {
        function inConversation() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if inConversation();
        allow create: if inConversation()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
      }
    }
  }
}
